# ========================================================
# SessionIQ Environment Configuration
# ========================================================

# --- Google Cloud Project Configuration ---
# Required for Vertex AI, Firestore (Native Mode), and Cloud Storage
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-ca621c40ffa0
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Gemini Model & Agent Configuration ---
# Options: gemini-2.5-flash, gemini-3.6-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Google Cloud Storage ---
# SessionIQ creates/uses: gs://${GOOGLE_CLOUD_PROJECT}-sessioniq-assets
SESSIONIQ_GCS_BUCKET=qwiklabs-gcp-04-ca621c40ffa0-sessioniq-assets

# --- Server Ports & URLs ---
PORT=8000
HOST=0.0.0.0
FRONTEND_PORT=5173

# --- Optional AI Studio Alternative (if not using GCP Vertex AI) ---
# GEMINI_API_KEY=your-gemini-api-key-here
